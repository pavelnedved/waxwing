{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Waxwing workspace lineage \u2014 draft 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "sources",
    "models"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1-workspace-draft"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "location"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "modelId",
          "location",
          "sourceRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "modelId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "uniqueItems": true
          },
          "elaborates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "model"
              ],
              "properties": {
                "model": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "element": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            "uniqueItems": true
          }
        }
      },
      "minItems": 1
    }
  }
}
