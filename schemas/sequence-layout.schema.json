{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Waxwing sequence JSON 2 \u2014 draft 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "diagramType",
    "model",
    "modelDigest",
    "layout",
    "canvas",
    "participants",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1-sequence-layout-draft"
    },
    "diagramType": {
      "const": "sequence"
    },
    "model": {
      "$ref": "sequence-model.schema.json"
    },
    "modelDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "version"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "box",
          "lifeline"
        ],
        "properties": {
          "ref": {
            "$ref": "system-model.schema.json#/$defs/id"
          },
          "box": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "lifeline": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "startY",
              "endY"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0
              },
              "startY": {
                "type": "number",
                "minimum": 0
              },
              "endY": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "from",
          "to",
          "points",
          "label"
        ],
        "properties": {
          "ref": {
            "$ref": "system-model.schema.json#/$defs/id"
          },
          "from": {
            "$ref": "system-model.schema.json#/$defs/id"
          },
          "to": {
            "$ref": "system-model.schema.json#/$defs/id"
          },
          "points": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y"
              ],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0
                },
                "y": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "maxItems": 4
          },
          "label": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    }
  }
}
